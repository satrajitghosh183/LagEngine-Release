	cd "/mnt/d/Master Things/Fall Sem Classes 2025/MasterThesisResearch/GameEngine/build" && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
